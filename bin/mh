#!/usr/bin/env bash
# MemoryHound CLI — install, run, verify autonomous DFIR triage cases.
#
# Subcommands:
#   mh doctor              health check — Python, Claude Code, deps, perms
#   mh init                first-time setup — venv, deps
#   mh run    <case-id>    run Claude Code triage on cases/<case-id>/input/
#   mh status              recent cases + their phase
#   mh tools               list MCP tools the agent can call
#   mh check               quick env probe (subset of doctor, exit code)
#
# Works with both Claude subscription (claude /login) and ANTHROPIC_API_KEY.
set -euo pipefail

MH_HOME="${MH_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
MH_VENV="${MH_VENV:-${MH_HOME}/.venv}"
MH_PY="${MH_VENV}/bin/python"
MH_CASES_DIR="${MH_HOME}/cases"

GREEN=$'\e[0;32m'
RED=$'\e[0;31m'
YELLOW=$'\e[0;33m'
BOLD=$'\e[1m'
NC=$'\e[0m'

ok()     { echo -e "${GREEN}✓${NC} $*"; }
warn()   { echo -e "${YELLOW}!${NC} $*"; }
fail()   { echo -e "${RED}✗${NC} $*"; }
info()   { echo -e "${BOLD}»${NC} $*"; }

# ─── claude wrapper ──────────────────────────────────────────────────────────

# claude_run: pipe a prompt to claude in non-interactive autonomous mode.
# We pass the prompt via stdin because --allowedTools is variadic and would
# consume the prompt as another tool name if passed positionally.
claude_run() {
    local prompt="$1"
    local allowed="mcp__protocol_sift__hash,mcp__protocol_sift__audit_append,mcp__protocol_sift__finding_record,mcp__protocol_sift__os_detect,mcp__protocol_sift__magic_check,mcp__protocol_sift__win_registry_get,mcp__protocol_sift__win_prefetch_parse,mcp__protocol_sift__win_evtx_query,mcp__protocol_sift__win_lnk_parse,mcp__protocol_sift__mac_plist_get,mcp__protocol_sift__mac_knowledgec_query,mcp__protocol_sift__memory_volatility,mcp__protocol_sift__linux_history_parse,mcp__protocol_sift__yara_scan,mcp__protocol_sift__memprocfs_findevil,mcp__protocol_sift__tsk_fls,mcp__protocol_sift__tsk_icat,mcp__protocol_sift__tsk_mmls,mcp__protocol_sift__tsk_mactime,mcp__protocol_sift__tsk_istat,mcp__protocol_sift__plaso_log2timeline,mcp__protocol_sift__plaso_psort,mcp__protocol_sift__ez_evtxecmd,mcp__protocol_sift__ez_mftecmd,mcp__protocol_sift__ez_recmd,mcp__protocol_sift__ez_amcacheparser,mcp__protocol_sift__tshark_extract,mcp__protocol_sift__zeek_log_read,mcp__protocol_sift__bulk_extractor,mcp__protocol_sift__binwalk,mcp__protocol_sift__strings_extract,Read,Write,Glob,Grep,TodoWrite"

    # Write resolved mcp-config at runtime — claude doesn't substitute
    # ${CLAUDE_PROJECT_DIR} in --mcp-config files.
    local mcp_cfg
    mcp_cfg="$(mktemp -t mh-mcp-XXXXXX.json)"
    cat > "$mcp_cfg" <<EOF
{
  "mcpServers": {
    "protocol_sift": {
      "command": "${MH_HOME}/bin/mh-mcp-server",
      "args": [],
      "env": {
        "EVIDENCE_PATH": "${EVIDENCE_PATH:-}",
        "OUTPUT_PATH": "${OUTPUT_PATH:-}",
        "CASE_ID": "${CASE_ID:-}",
        "MH_HOME": "${MH_HOME}"
      }
    }
  }
}
EOF
    export CLAUDE_PROJECT_DIR="$MH_HOME"
    # Substitute $mcp_cfg now (at trap-set time) so the trap body is
    # self-contained at RETURN — `local mcp_cfg` is out of scope by then,
    # and `set -u` would error on a bare $mcp_cfg lookup.
    trap "rm -f '$mcp_cfg'" RETURN

    if [[ "${MH_CLAUDE_HEADLESS:-0}" == "1" ]]; then
        # Headless: -p print mode for CI/scripts. Silent. Use MH_CLAUDE_HEADLESS=1.
        printf '%s' "$prompt" | claude -p --mcp-config "$mcp_cfg" --allowedTools "$allowed"
        return $?
    fi

    # Default: full interactive Claude Code TUI. User sees tool calls + reasoning
    # live. Claude exits autonomously when prompt is satisfied; if it stalls
    # waiting for user input, type /exit.
    info "Claude Code will open in your terminal. You'll see every tool call"
    info "live (os_detect, mac_plist_get, finding_record, etc)."
    info "When triage is complete or you want to stop, type /exit."
    sleep 1
    claude --mcp-config "$mcp_cfg" --allowedTools "$allowed" -- "$prompt"
}

# ─── doctor ──────────────────────────────────────────────────────────────────

cmd_doctor() {
    local errors=0
    info "MemoryHound doctor — checking environment"
    echo ""

    if command -v python3.13 >/dev/null 2>&1; then
        ok "Python 3.13 available: $(command -v python3.13)"
    elif command -v python3.12 >/dev/null 2>&1; then
        ok "Python 3.12 available: $(command -v python3.12)"
    elif command -v python3.11 >/dev/null 2>&1; then
        ok "Python 3.11 available: $(command -v python3.11)"
    else
        fail "No Python 3.11+ found. Install: brew install python@3.12 (macOS) or apt install python3.12 (Ubuntu)"
        errors=$((errors + 1))
    fi

    if [[ -x "$MH_PY" ]]; then
        ok "venv at $MH_VENV ($("$MH_PY" --version 2>&1))"
    else
        warn "venv not yet created — run: mh init"
    fi

    if [[ -x "$MH_PY" ]]; then
        if "$MH_PY" -c "import protocol_sift_mcp" 2>/dev/null; then
            ok "protocol_sift_mcp installed in venv"
        else
            warn "protocol_sift_mcp not installed — run: mh init"
        fi
        if "$MH_PY" -c "import Registry, Evtx, pylnk3, windowsprefetch" 2>/dev/null; then
            ok "Windows forensic libs ready (Registry, Evtx, pylnk3, windowsprefetch)"
        else
            warn "Windows forensic libs missing — run: mh init --with-forensics (optional, only needed for real evidence)"
        fi
    fi

    if command -v claude >/dev/null 2>&1; then
        ok "Claude Code installed: $(command -v claude)"
        if claude --version 2>/dev/null | head -1; then :; fi
    else
        fail "Claude Code not installed. Install: https://docs.claude.com/en/docs/claude-code/quickstart"
        errors=$((errors + 1))
    fi

    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        ok "ANTHROPIC_API_KEY set (auth mode: API key)"
    elif [[ -d "$HOME/.claude" ]]; then
        ok "~/.claude/ exists (auth mode: Pro/Max login likely active — run 'claude /status' to confirm)"
    else
        warn "No ANTHROPIC_API_KEY env var and no ~/.claude/ — auth not configured"
        warn "    EITHER  export ANTHROPIC_API_KEY=sk-ant-...   OR   claude /login"
    fi

    if [[ -f "${MH_HOME}/.claude/settings.json" ]]; then
        ok ".claude/settings.json present (Claude Code will pick up MCP + hooks here)"
    else
        fail ".claude/settings.json missing — repo seems incomplete"
        errors=$((errors + 1))
    fi

    if [[ -x "${MH_HOME}/bin/mh-mcp-server" ]]; then
        ok "MCP server launcher executable"
    else
        warn "bin/mh-mcp-server not executable — run: chmod +x bin/mh-mcp-server"
    fi

    if [[ -x "${MH_VENV}/bin/mh-orchestrate" ]]; then
        ok "mh-orchestrate installed"
    else
        warn "mh-orchestrate missing — run: mh init"
    fi

    # ISF symbol cache check (warn-only — absence does not fail doctor)
    local isf_path="${MH_HOME}/corpus/dfrws-2008-memory/symbols/linux/2.6.18-8.1.15.el5_64.json.xz"
    if [[ -f "$isf_path" ]]; then
        ok "ISF symbol cache — $(wc -c <"$isf_path" 2>/dev/null | tr -d ' ' || echo '?') bytes vendored"
    else
        warn "ISF symbols missing at $isf_path — Volatility linux.* plugins will return empty (run: scripts/fetch-isf-symbols.sh)"
    fi

    # Docker presence check (info-only — Docker is optional)
    if command -v docker >/dev/null 2>&1; then
        info "Docker — $(docker --version 2>&1 | head -1) (optional; host install does not require it)"
    else
        info "Docker — not on PATH (optional; install for the containerized deployment path — see docs/deployment.md)"
    fi

    echo ""
    if [[ $errors -eq 0 ]]; then
        ok "All critical checks passed."
        info "Next: drop evidence into cases/<id>/input/, then 'mh run <id>'"
        return 0
    else
        fail "$errors critical issue(s). Fix above before running cases."
        return 1
    fi
}

# ─── init ────────────────────────────────────────────────────────────────────

cmd_init() {
    local with_forensics=0
    for arg in "$@"; do
        case "$arg" in
            --with-forensics) with_forensics=1 ;;
            -h|--help) echo "Usage: mh init [--with-forensics]"; return 0 ;;
        esac
    done

    info "MemoryHound init — creating venv + installing deps"

    # OS detection drives the error messages so newbies see the right install
    # command for their platform.
    local OS_KIND="unknown"
    case "$(uname -s)" in
        Darwin) OS_KIND="macos" ;;
        Linux)  OS_KIND="linux" ;;
    esac

    local PY=""
    for cand in python3.13 python3.12 python3.11; do
        if command -v "$cand" >/dev/null 2>&1; then
            PY="$cand"; break
        fi
    done
    if [[ -z "$PY" ]]; then
        fail "Python 3.11+ required and not found on PATH."
        case "$OS_KIND" in
            macos)
                info "    Install via Homebrew:"
                info "      brew install python@3.12"
                info "    Then re-run: mh init"
                ;;
            linux)
                info "    Install via apt:"
                info "      sudo apt-get install -y python3.12 python3.12-venv"
                info "    Or via dnf:"
                info "      sudo dnf install -y python3.12"
                ;;
            *)
                info "    Install Python 3.11+ from https://www.python.org/downloads/"
                ;;
        esac
        return 1
    fi
    info "Using $PY ($(command -v "$PY"))"

    # Surface a claude-CLI hint up front so newbies know what they'll need
    # next — but don't block init on it. (Real triage needs it; init does not.)
    if ! command -v claude >/dev/null 2>&1; then
        warn "claude CLI not on PATH (you'll need it to run real triage)."
        info "    Install Claude Code: https://docs.claude.com/en/docs/claude-code/quickstart"
    fi

    # Create or repair the venv. A common Debian/Ubuntu pitfall: if
    # python3.X-venv wasn't installed when the venv was first created, the
    # resulting venv has no pip (`python -m venv` silently skipped ensurepip).
    # Detect that and rebuild — otherwise every later pip call fails with
    # "No module named pip" against a venv that LOOKS present.
    if [[ ! -x "$MH_PY" ]]; then
        info "Creating venv at $MH_VENV"
        "$PY" -m venv "$MH_VENV"
    elif ! "$MH_PY" -m pip --version >/dev/null 2>&1; then
        warn "existing venv at $MH_VENV has no pip — rebuilding"
        warn "  (this happens when python3.X-venv was installed AFTER the first init)"
        rm -rf "$MH_VENV"
        "$PY" -m venv "$MH_VENV"
    fi

    # Final guard: if ensurepip still didn't bootstrap pip into the new venv
    # (rare — broken python3.X-venv package), surface the failure loudly
    # rather than letting the next pip call produce a cryptic error.
    if ! "$MH_PY" -m pip --version >/dev/null 2>&1; then
        fail "venv created but pip not available — try: $PY -m ensurepip --default-pip"
        fail "  or reinstall: sudo apt install --reinstall ${PY}-venv"
        return 1
    fi

    info "Installing protocol_sift_mcp (core + dev)"
    "$MH_PY" -m pip install --quiet --upgrade pip
    "$MH_PY" -m pip install --quiet -e "${MH_HOME}/mcp-server[dev]"

    info "Installing orchestrator package (editable)…"
    "$MH_PY" -m pip install --quiet -e "${MH_HOME}/orchestrator"

    if [[ $with_forensics -eq 1 ]]; then
        info "Installing forensics extras (heavy: volatility3, python-evtx, etc)"
        "$MH_PY" -m pip install --quiet -e "${MH_HOME}/mcp-server[dev,forensics]"
    fi

    chmod +x "${MH_HOME}"/bin/mh "${MH_HOME}"/bin/mh-mcp-server "${MH_HOME}"/.claude/hooks/*.sh 2>/dev/null || true

    mkdir -p "$MH_CASES_DIR"

    # MH_INIT_SKIP_TESTS=1 lets newbies skip the ~3s pytest step and get to
    # the demo faster. Tests still runnable later via: mh doctor / mh check.
    if [[ "${MH_INIT_SKIP_TESTS:-0}" == "1" ]]; then
        info "MH_INIT_SKIP_TESTS=1 — skipping test suite verification"
    else
        info "Running test suite to verify install (set MH_INIT_SKIP_TESTS=1 to skip)"
        if PYTHONPATH="${MH_HOME}/mcp-server/src" "$MH_PY" -m pytest "${MH_HOME}/mcp-server/tests" -q --no-cov 2>&1 | tail -5; then
            ok "Tests passing"
        else
            warn "Tests did not all pass — check above"
        fi
    fi

    echo ""
    ok "Init complete."
    info "Next: 'mh quickstart' for auth check + 60-second demo"
}

# ─── run ─────────────────────────────────────────────────────────────────────

# cmd_run: ONE command for full IR triage.
#
# Argument can be:
#   - A case name (mh run case-001)         → uses cases/case-001/input/
#   - A file path (mh run /tmp/dump.raw)    → auto-creates cases/<derived>/input/,
#                                              copies/symlinks the file
#   - A folder path (mh run /tmp/evidence/) → auto-creates cases/<derived>/input/,
#                                              copies/symlinks every file inside
#
# Mode:
#   - Default: LangGraph state machine (deterministic IR pipeline — uses skills,
#     subagents, verifier loop, correlator, CSF/ISO/PICERL framework mapping).
#   - --interactive: skill-driven free-form Claude Code TUI (live tool calls
#     visible — for exploratory casework).
#
# After triage completes the function prints:
#   - Path to all artifacts (findings.json, narrative.md, accuracy-report.md,
#     audit.jsonl, manifest.json, etc.)
#   - The exact `mh serve` and `mh report` commands to browse them
#
# Auto-starting `mh serve` in background would create a process the user can't
# easily kill — surfacing the command is cleaner.

cmd_run() {
    local arg="${1:-}"
    local interactive=0
    local extra_args=()

    # Parse flags. First positional that isn't a flag is the case argument.
    if [[ -z "$arg" || "$arg" == "-h" || "$arg" == "--help" ]]; then
        cat <<EOF
Usage: mh run <case-name|file-path|folder-path> [--interactive]

  case name      mh run case-001                 # uses cases/case-001/input/
  file path      mh run /Downloads/memory.raw    # wraps file in a new case
  folder path    mh run /Downloads/evidence/     # wraps folder in a new case

  --interactive  Skill-driven Claude TUI (live tool calls). Default is
                 the deterministic LangGraph pipeline.

  -h, --help     This help.

The pipeline (default mode) covers everything: SHA256 manifest, ingest,
OS detection, skill routing, subagent triage (Windows/macOS/Linux),
Volatility memory analysis, Verifier dissent loop, MITRE ATT&CK tagging,
NIST CSF 2.0 / ISO 27035 / PICERL framework mapping, D3FEND
countermeasure recommendations, containment + remediation plans,
investigator narrative, accuracy report, and a sha256-chained audit log.
EOF
        return 0
    fi
    shift
    while (( $# > 0 )); do
        case "$1" in
            --interactive|-i) interactive=1; shift ;;
            *)                extra_args+=("$1"); shift ;;
        esac
    done

    # ─── Resolve case_id from arg (name vs file vs folder) ────────────────
    local case_id=""
    local input_dir=""
    local copy_source=""

    if [[ -e "$arg" ]] && [[ "$arg" != "${arg#/}" || "$arg" == ./* || "$arg" == ~* ]]; then
        # Looks like a path (absolute, ./relative, or ~-expanded). Auto-wrap.
        local abs_path
        abs_path="$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
        local stem
        stem="$(basename "$arg")"
        # Strip trailing slash from folder names, then strip extension from
        # files. Final case_id is a friendly slug.
        stem="${stem%/}"
        case_id="${stem%.*}"
        case_id="${case_id//[^a-zA-Z0-9._-]/-}"
        if [[ -z "$case_id" ]]; then
            case_id="case-$(date +%Y%m%d-%H%M%S)"
        fi
        copy_source="$abs_path"
        info "auto-wrapping path as case: ${case_id}"
        info "  source: ${abs_path}"
    elif [[ -d "${MH_CASES_DIR}/${arg}/input" ]] || [[ "$arg" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        # Treat as case name. Either the input/ dir already exists (existing
        # case) or the arg is a clean slug (new empty case the user wants
        # to scaffold).
        case_id="$arg"
    else
        fail "argument '$arg' is neither an existing path nor a valid case name"
        info "  case names: letters/digits/dash/underscore/dot only"
        info "  paths: must exist on disk (file or folder)"
        return 2
    fi

    local case_dir="${MH_CASES_DIR}/${case_id}"
    input_dir="${case_dir}/input"
    local output_dir="${case_dir}/output"
    mkdir -p "$input_dir"

    # ─── If we auto-wrapped a path, copy/symlink it into input/ ───────────
    if [[ -n "$copy_source" ]]; then
        if [[ -f "$copy_source" ]]; then
            info "copying $(basename "$copy_source") → ${input_dir}/"
            cp -n "$copy_source" "${input_dir}/" || warn "file already in input/ — keeping existing"
        elif [[ -d "$copy_source" ]]; then
            info "copying contents of $(basename "$copy_source")/ → ${input_dir}/"
            # -n: no-clobber. -R: recursive. -L: follow symlinks. Trailing /. is
            # rsync-style for "copy contents not the dir itself".
            cp -Rn -L "$copy_source"/. "${input_dir}/" 2>/dev/null || true
        fi
    fi

    if [[ -z "$(ls -A "$input_dir" 2>/dev/null | grep -v '^.gitkeep$')" ]]; then
        fail "${input_dir} has no evidence files"
        info "  drop files into ${input_dir}/ then re-run, OR"
        info "  rerun with a path argument: mh run /path/to/evidence"
        return 2
    fi

    # ─── Auth + claude CLI gates ──────────────────────────────────────────
    if [[ -z "${ANTHROPIC_API_KEY:-}" ]] && [[ ! -d "$HOME/.claude" ]]; then
        fail "no Claude auth. Run: claude /login   OR   export ANTHROPIC_API_KEY=sk-ant-..."
        return 1
    fi
    if ! command -v claude >/dev/null 2>&1; then
        fail "claude CLI not installed"
        info "  install: https://docs.claude.com/en/docs/claude-code/quickstart"
        return 1
    fi

    # ─── Fresh-cycle output dir ───────────────────────────────────────────
    if [[ -d "$output_dir" ]] && [[ -n "$(ls -A "$output_dir" 2>/dev/null)" ]]; then
        info "resetting prior output for fresh cycle"
    fi
    rm -rf "$output_dir"
    mkdir -p "$output_dir"

    info "case:       ${case_id}"
    info "evidence:   ${input_dir}"
    info "output:     ${output_dir}"
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        info "auth:       API key"
    else
        info "auth:       Claude subscription (Pro/Max)"
    fi

    export CASE_ID="$case_id"
    export EVIDENCE_PATH="$input_dir"
    export OUTPUT_PATH="$output_dir"
    export MH_HOME

    cd "$MH_HOME"

    # ─── Dispatch to the chosen execution mode ────────────────────────────
    local rc=0
    if (( interactive )); then
        info "mode:       interactive (skill-driven Claude TUI)"
        echo ""
        claude_run "Use the triage-orchestrator skill to autonomously triage every artifact under ${input_dir}. Route to the correct OS specialist (Windows/macOS/Linux). Pin every finding to its source tool + artifact. Acknowledge gaps explicitly via gap-acknowledgment. Stop when triage is complete. Write findings.json, narrative.md, and accuracy-report.md to ${output_dir}." || rc=$?
    else
        info "mode:       LangGraph (deterministic full IR pipeline)"
        echo ""
        if [[ ! -x "${MH_VENV}/bin/mh-orchestrate" ]]; then
            fail "mh-orchestrate not installed. Run: mh init"
            return 1
        fi
        "${MH_VENV}/bin/mh-orchestrate" run "$case_id" --cases-dir "$MH_CASES_DIR" "${extra_args[@]}" || rc=$?
    fi

    # ─── Surface results regardless of exit code ──────────────────────────
    echo ""
    if (( rc == 0 )); then
        ok "triage complete."
    else
        warn "triage exited with code $rc — partial results may still be present"
    fi

    echo ""
    info "results: ${output_dir}/"
    if compgen -G "${output_dir}/*" > /dev/null; then
        ls -1 "$output_dir" | sed 's|^|  |'
    fi
    echo ""
    info "next:"
    info "  ${BOLD}mh serve${NC}                            # browse results at http://127.0.0.1:8765/"
    info "  ${BOLD}mh report --exec ${case_id}${NC}    # one-page executive summary"
    info "  ${BOLD}mh verify ${case_id}${NC}          # chain-of-custody re-hash"

    return $rc
}

# ─── orchestrate (LangGraph state-machine driven) ──────────────────────────

# Backward-compatibility alias. The default mode of `mh run` IS LangGraph
# orchestration as of the unified-CLI refactor — `mh orchestrate <case>` is
# equivalent to `mh run <case>`. Kept so existing scripts / docs / muscle
# memory keep working.
cmd_orchestrate() {
    info "note: 'mh orchestrate' is now an alias for 'mh run' (LangGraph is the default mode)"
    cmd_run "$@"
}

# ─── serve (local web viewer) ────────────────────────────────────────────────

cmd_serve() {
    local port="${MH_SERVE_PORT:-8765}"
    local host="127.0.0.1"
    for arg in "$@"; do
        case "$arg" in
            --port=*) port="${arg#--port=}" ;;
            --host=*) host="${arg#--host=}" ;;
            -h|--help) echo "Usage: mh serve [--port=8765] [--host=127.0.0.1]"; return 0 ;;
        esac
    done

    if ! "$MH_PY" -c "import markdown" 2>/dev/null; then
        info "Installing markdown viewer dep into venv (one-time)…"
        "$MH_PY" -m pip install --quiet markdown pygments
    fi

    info "Starting MemoryHound viewer on http://${host}:${port}/"
    info "Press Ctrl-C to stop."
    echo ""
    if command -v open >/dev/null 2>&1; then
        ( sleep 1 && open "http://${host}:${port}/" ) &
    elif command -v xdg-open >/dev/null 2>&1; then
        ( sleep 1 && xdg-open "http://${host}:${port}/" ) &
    fi
    "$MH_PY" "${MH_HOME}/scripts/serve.py" --host "$host" --port "$port"
}

# ─── scope (multi-host parallel self-collect over SSH) ─────────────────────

# cmd_scope <base-case-id> --hosts host1,host2,host3 [--key=PATH] [--user=NAME]
#
# Fans out scripts/self-collect.sh over SSH to each named host in parallel,
# then rsyncs the artifacts back to cases/<base>-<host>/input/. Each host
# becomes its own case dir so subsequent `mh run` / `mh orchestrate` calls
# pivot per host without needing extra wiring.
#
# `localhost` is treated as a special case — script runs in-process, no SSH.
# Useful for smoke-testing the multi-host pipeline without a real fleet.
cmd_scope() {
    local base_id=""
    local hosts_csv=""
    local ssh_user=""
    local ssh_key=""
    local parallelism="4"
    for arg in "$@"; do
        case "$arg" in
            --hosts=*)        hosts_csv="${arg#--hosts=}" ;;
            --user=*)         ssh_user="${arg#--user=}" ;;
            --key=*)          ssh_key="${arg#--key=}" ;;
            --parallelism=*)  parallelism="${arg#--parallelism=}" ;;
            -h|--help)
                cat <<EOF
Usage: mh scope <base-case-id> --hosts=host1,host2,host3 [options]

  Fans out scripts/self-collect.sh over SSH to each host and rsyncs the
  artifacts into cases/<base>-<host>/input/. Each host becomes its own
  case directory ready for mh run / mh orchestrate.

Options:
  --hosts=CSV       Comma-separated list of hostnames (required).
                    Use 'localhost' for in-process smoke testing.
  --user=NAME       SSH user for all hosts (defaults to current user).
  --key=PATH        SSH private key (passes -i to ssh).
  --parallelism=N   Max concurrent SSH sessions (default 4).
EOF
                return 0
                ;;
            *) base_id="$arg" ;;
        esac
    done
    if [[ -z "$base_id" ]] || [[ -z "$hosts_csv" ]]; then
        fail "Usage: mh scope <base-case-id> --hosts=host1,host2,..."
        return 2
    fi

    local self_collect="${MH_HOME}/scripts/self-collect.sh"
    if [[ ! -x "$self_collect" ]]; then
        fail "scripts/self-collect.sh not found or not executable at ${self_collect}"
        return 1
    fi

    # Split CSV into array (handles 'a,b,c' and 'a, b, c' forms).
    local IFS_BACKUP="$IFS"
    IFS=',' read -ra hosts <<< "${hosts_csv// /}"
    IFS="$IFS_BACKUP"

    mkdir -p "$MH_CASES_DIR"
    info "Scope: ${#hosts[@]} hosts → cases/${base_id}-<host>/input/"
    info "Parallelism: ${parallelism}"

    local ssh_opts=(
        -o "StrictHostKeyChecking=accept-new"
        -o "ConnectTimeout=10"
        -o "BatchMode=yes"
    )
    [[ -n "$ssh_user" ]] && ssh_opts+=(-l "$ssh_user")
    [[ -n "$ssh_key" ]] && ssh_opts+=(-i "$ssh_key")

    # Per-host worker. Runs in a subshell so we can `wait` for many at once.
    _scope_one_host() {
        local host="$1"
        local case_dir="${MH_CASES_DIR}/${base_id}-${host}"
        local input_dir="${case_dir}/input"
        mkdir -p "$input_dir"

        local prefix="[${host}]"
        if [[ "$host" == "localhost" ]] || [[ "$host" == "127.0.0.1" ]]; then
            # Local path — no SSH. Smoke test mode.
            echo "${prefix} self-collect → ${input_dir}"
            if "$self_collect" "$input_dir" >/dev/null 2>&1; then
                echo "${prefix} ✓ collected $(ls "$input_dir" | wc -l | tr -d ' ') artifacts"
                return 0
            else
                echo "${prefix} ✗ self-collect failed"
                return 1
            fi
        fi

        # Remote — pipe the script over stdin so the remote host doesn't
        # need a pre-installed copy of self-collect.sh.
        local remote_dest="/tmp/mh-collect-${base_id}-${host}-$$"
        echo "${prefix} ssh → ${remote_dest}"
        if ! ssh "${ssh_opts[@]}" "$host" \
                "mkdir -p '${remote_dest}' && bash -s -- '${remote_dest}'" \
                < "$self_collect" >/dev/null 2>&1; then
            echo "${prefix} ✗ remote self-collect failed (ssh/exec)"
            return 1
        fi

        # Rsync if available (incremental + restart), else scp.
        if command -v rsync >/dev/null 2>&1; then
            if ! rsync -az --delete \
                    -e "ssh ${ssh_opts[*]}" \
                    "${host}:${remote_dest}/" "${input_dir}/" >/dev/null 2>&1; then
                echo "${prefix} ✗ rsync back failed"
                return 1
            fi
        else
            if ! scp -r "${ssh_opts[@]}" \
                    "${host}:${remote_dest}/." "${input_dir}/" >/dev/null 2>&1; then
                echo "${prefix} ✗ scp back failed"
                return 1
            fi
        fi

        # Best-effort cleanup of remote temp dir; don't fail the host on this.
        ssh "${ssh_opts[@]}" "$host" "rm -rf '${remote_dest}'" >/dev/null 2>&1 || true
        echo "${prefix} ✓ collected $(ls "$input_dir" | wc -l | tr -d ' ') artifacts"
        return 0
    }

    # Fire workers up to --parallelism. Use a counting semaphore via
    # xargs -P: print one host per line, xargs spawns N at a time.
    export -f _scope_one_host
    export MH_CASES_DIR base_id self_collect
    # ssh_opts is an array; reflatten into env via space-joined string.
    export MH_SCOPE_SSH_OPTS="${ssh_opts[*]}"

    local failures=0
    # Print hosts one per line, run in parallel, capture exit-code rollup.
    if ! printf "%s\n" "${hosts[@]}" \
        | xargs -I{} -P "${parallelism}" bash -c '_scope_one_host "$@"' _ {}; then
        failures=$?
    fi

    # Aggregate result line.
    local landed=0
    for h in "${hosts[@]}"; do
        local d="${MH_CASES_DIR}/${base_id}-${h}/input"
        if [[ -d "$d" ]] && [[ -n "$(ls -A "$d" 2>/dev/null || true)" ]]; then
            landed=$((landed + 1))
        fi
    done

    info "Scope complete: ${landed}/${#hosts[@]} host case dirs populated"
    if (( landed == 0 )); then
        fail "No host case dirs were populated — check SSH access + key"
        return 1
    fi
    info "Next: ./bin/mh run ${base_id}-<host>  (or mh orchestrate ${base_id}-<host>)"
}

# ─── report (plain-English summary, no LLM, no tokens) ──────────────────────

cmd_report() {
    # Three modes:
    #   mh report <case-id>          - plain-English non-technical summary
    #   mh report --exec <case-id>   - executive incident report (one-page
    #                                   exec view + technical appendix +
    #                                   platform-specific containment cmds)
    #   mh report --pdf <case-id>    - render exec-report.md to a branded PDF
    #                                   via WeasyPrint (requires
    #                                   `pip install weasyprint markdown`).
    #                                   Auto-runs --exec first if exec-report.md
    #                                   isn't already present.
    local exec_mode=0
    local pdf_mode=0
    local case_id=""
    for arg in "$@"; do
        case "$arg" in
            --exec) exec_mode=1 ;;
            --pdf)  pdf_mode=1 ;;
            -h|--help)
                echo "Usage: mh report [--exec|--pdf] <case-id>"
                echo "  default       Plain-English summary for non-technical readers"
                echo "  --exec        Executive report with next-4h actions + commands"
                echo "  --pdf         Branded PDF of the exec report (WeasyPrint)"
                return 0
                ;;
            *) case_id="$arg" ;;
        esac
    done
    if [[ -z "$case_id" ]]; then
        fail "Usage: mh report [--exec|--pdf] <case-id>"
        return 2
    fi
    local case_dir="${MH_CASES_DIR}/${case_id}"
    if [[ ! -d "$case_dir/output" ]]; then
        fail "No output dir at ${case_dir}/output — run mh run first"
        return 1
    fi

    if (( pdf_mode )); then
        # Ensure the exec markdown exists — it's the source for the PDF.
        if [[ ! -f "${case_dir}/output/exec-report.md" ]]; then
            info "exec-report.md missing — running --exec first to produce it"
            "$MH_PY" "${MH_HOME}/scripts/exec-report.py" "$case_dir" || {
                fail "exec-report.py failed — see output above"
                return 1
            }
        fi
        info "Rendering PDF via WeasyPrint…"
        if ! "$MH_PY" "${MH_HOME}/scripts/generate_pdf_report.py" "$case_dir"; then
            fail "PDF render failed — see error above"
            info "  Install deps:  $MH_PY -m pip install weasyprint markdown"
            info "  Linux runtime: sudo apt-get install -y python3-gi python3-gi-cairo gir1.2-gtk-3.0 libpango-1.0-0"
            return 1
        fi
        echo ""
        ok "PDF report at ${case_dir}/output/report.pdf"
        return 0
    fi

    if (( exec_mode )); then
        "$MH_PY" "${MH_HOME}/scripts/exec-report.py" "$case_dir"
        local out="${case_dir}/output/exec-report.md"
        echo ""
        info "Executive incident report at ${out}"
        echo ""
        head -40 "$out"
        return 0
    fi

    "$MH_PY" "${MH_HOME}/scripts/plain-summary.py" "$case_dir"
    local out="${case_dir}/output/summary.md"
    echo ""
    info "Plain-English summary at ${out}"
    echo ""
    head -40 "$out"
}

# ─── status ──────────────────────────────────────────────────────────────────

cmd_status() {
    if [[ ! -d "$MH_CASES_DIR" ]]; then
        info "No cases yet. mh run <id> creates one."
        return 0
    fi

    info "Cases:"
    for case_dir in "$MH_CASES_DIR"/*/; do
        [[ ! -d "$case_dir" ]] && continue
        local id
        id=$(basename "$case_dir")
        local phase="empty"
        if [[ -f "${case_dir}/output/findings.json" ]]; then
            phase="${GREEN}finished${NC}"
        elif [[ -f "${case_dir}/output/manifest.json" ]] && [[ -f "${case_dir}/output/audit.jsonl" ]]; then
            # Manifest + audit = demo / verify-only run completed cleanly.
            phase="${GREEN}demo-complete${NC}"
        elif [[ -f "${case_dir}/output/audit.jsonl" ]]; then
            phase="${YELLOW}in-progress${NC}"
        elif [[ -d "${case_dir}/input" ]] && [[ -n "$(ls -A "${case_dir}/input" 2>/dev/null)" ]]; then
            phase="staged"
        fi
        echo -e "  ${id}  →  ${phase}"
    done
}

# ─── tools ───────────────────────────────────────────────────────────────────

cmd_tools() {
    # Honour --tier=N to filter; default shows all tools grouped by tier.
    local tier_filter=""
    for arg in "$@"; do
        case "$arg" in
            --tier=*) tier_filter="${arg#--tier=}" ;;
            -h|--help)
                echo "Usage: mh tools [--tier=1|2|3]"
                echo "  Lists MCP tools grouped by IR signal tier."
                echo "  Tier 1 = high-signal, decision-driving (run these first)."
                echo "  Tier 2 = corroboration/timeline."
                echo "  Tier 3 = bulk / audit / routing primitives."
                return 0
                ;;
        esac
    done

    if [[ -n "$tier_filter" ]]; then
        info "MCP tools at IR signal tier ${tier_filter}:"
        "$MH_PY" -c "
from protocol_sift_mcp.signal_tiers import tools_at_tier
tier = int('${tier_filter}')
for name in tools_at_tier(tier):
    print(f'  {name}')
"
        return 0
    fi

    info "MCP tools exposed by protocol_sift (grouped by IR signal tier):"
    "$MH_PY" -c "
from protocol_sift_mcp.signal_tiers import tier_summary
labels = {
    1: 'Tier 1 — high-signal, decision-driving (run first)',
    2: 'Tier 2 — corroboration / recent-activity / timeline',
    3: 'Tier 3 — bulk / audit / routing primitives',
}
descriptions = {
    # Memory + filesystem + timeline (heaviest signal first)
    'memory_volatility':    'Volatility 3 — 45+ plugins (windows/linux/mac core+hiding+kernel)',
    'memprocfs_findevil':   'MemProcFS FindEvil — built-in evil-hunt heuristics over memory',
    'tsk_fls':              'Sleuth Kit fls — file + dir listing in a disk image',
    'tsk_icat':             'Sleuth Kit icat — extract file content by inode',
    'tsk_mmls':             'Sleuth Kit mmls — partition layout',
    'tsk_mactime':          'Sleuth Kit mactime — MACB timeline from bodyfile',
    'tsk_istat':            'Sleuth Kit istat — inode metadata',
    'plaso_log2timeline':   'Plaso log2timeline — extract .plaso store from source',
    'plaso_psort':          'Plaso psort — sort + render .plaso → json_line / csv',
    # Windows artifacts
    'win_evtx_query':       'Windows event logs (4624/4625/4688/7045 = auth + exec + svc)',
    'win_registry_get':     'Registry hives (Run/RunOnce/Services persistence)',
    'win_lnk_parse':        'Windows .lnk shortcuts (target + drive_serial)',
    'win_prefetch_parse':   'Windows .pf prefetch (execution proof)',
    'ez_evtxecmd':          'EZ Tools EvtxECmd — EVTX → CSV (needs dotnet)',
    'ez_mftecmd':           'EZ Tools MFTECmd — NTFS MFT to CSV',
    'ez_recmd':             'EZ Tools RECmd — registry hive + batch plugins',
    'ez_amcacheparser':     'EZ Tools AmcacheParser — execution evidence',
    # macOS + Linux
    'mac_knowledgec_query': 'macOS KnowledgeC (recent apps + focus)',
    'mac_plist_get':        'macOS plist (LaunchAgents/Daemons + prefs)',
    'linux_history_parse':  'bash + zsh history (recent commands)',
    # Network + malware + carving
    'tshark_extract':       'Wireshark tshark field extraction over pcap',
    'zeek_log_read':        'Zeek TSV log parser (conn/dns/ssl/http)',
    'yara_scan':            'YARA — compile rules + scan file or directory',
    'bulk_extractor':       'bulk_extractor — IPs/URLs/emails/CCN from any blob',
    'binwalk':              'binwalk — embedded files + firmware structure',
    'strings_extract':      'pure-Python ASCII strings extraction',
    # Audit + finding + routing
    'hash':                 'sha256 + sha1 + size',
    'audit_append':         'append to hash-chained audit log',
    'finding_record':       'register finding (rejects un-pinned)',
    'os_detect':            'magic-byte + dir-marker OS classification',
    'magic_check':          'first-16-bytes signature probe',
}
for tier in (1, 2, 3):
    print()
    print(f'  {labels[tier]}')
    for name in tier_summary()[tier]:
        desc = descriptions.get(name, '')
        print(f'    {name:<22s} — {desc}')
"
}

# ─── check (quick env probe with exit code) ─────────────────────────────────

cmd_check() {
    if cmd_doctor >/dev/null 2>&1; then
        ok "OK"
        return 0
    else
        fail "FAIL — run 'mh doctor' for details"
        return 1
    fi
}

# ─── quickstart ──────────────────────────────────────────────────────────────
# One command from "freshly installed" to "demo output on screen."
# Sequence: doctor (critical only) → auth check → demo (stub mode by default).
# Newbie-friendly: prints exact next-step commands at each branch.

cmd_quickstart() {
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                echo "Usage: mh quickstart"
                echo ""
                echo "  Runs doctor + auth check + stub demo (no tokens)."
                echo "  After this completes, you're ready to drop evidence into"
                echo "  cases/<id>/input/ and run 'mh run <id>'."
                echo ""
                echo "  Never invokes paid Claude APIs. Use 'mh demo --real-claude'"
                echo "  for the explicit ~\$0.01 smoke test."
                return 0
                ;;
        esac
    done

    info "MemoryHound quickstart — first-run sanity + demo"
    echo ""

    # ─── Step 1: doctor (critical-only) ──────────────────────────────────────
    info "Step 1/3: environment check"
    if ! cmd_doctor; then
        echo ""
        fail "Environment check failed — see ✗/! lines above."
        info "    Fix the failing items, then re-run: mh quickstart"
        return 1
    fi

    # ─── Step 2: auth check ──────────────────────────────────────────────────
    echo ""
    info "Step 2/3: Claude Code auth check"
    local has_subscription=0
    local has_api_key=0
    [[ -d "$HOME/.claude" ]] && has_subscription=1
    [[ -n "${ANTHROPIC_API_KEY:-}" ]] && has_api_key=1

    if (( has_subscription )) && (( has_api_key )); then
        ok "Both auth paths present (ANTHROPIC_API_KEY takes precedence over subscription)"
        warn "  If subscription-based auth is desired, unset ANTHROPIC_API_KEY for this session:"
        info "    unset ANTHROPIC_API_KEY"
    elif (( has_subscription )); then
        ok "Subscription auth active (~/.claude exists)"
        info "  If 'claude /status' shows 'Not logged in', re-run: claude /login"
    elif (( has_api_key )); then
        ok "API key auth active (ANTHROPIC_API_KEY set)"
    else
        fail "No Claude auth configured."
        echo ""
        info "    Choose ONE of:"
        info "      claude /login                       # Pro/Max subscription (recommended)"
        info "      export ANTHROPIC_API_KEY=sk-ant-…    # API key"
        echo ""
        info "    Then re-run: mh quickstart"
        return 1
    fi

    # ─── Step 3: stub demo (no tokens) ───────────────────────────────────────
    echo ""
    info "Step 3/3: running stub demo (no tokens spent)"
    echo ""
    if ! cmd_demo; then
        echo ""
        fail "Demo failed — see output above."
        return 1
    fi

    # ─── next-step guidance ──────────────────────────────────────────────────
    echo ""
    ok "Quickstart complete."
    echo ""
    info "Next — full IR triage in one command:"
    info "  ${BOLD}mh run /path/to/evidence-file-or-folder${NC}"
    info "      (or use an existing case name: ${BOLD}mh run case-001${NC})"
    echo ""
    info "After triage:"
    info "  ${BOLD}mh serve${NC}                  # browse findings at http://127.0.0.1:8765/"
    info "  ${BOLD}mh report --exec <case>${NC}   # one-page executive summary"
    info "  ${BOLD}mh verify <case>${NC}          # chain-of-custody re-hash"
    echo ""
    info "Real-Claude smoke (~\$0.01): mh demo --real-claude"
}

# ─── self-collect ────────────────────────────────────────────────────────────

cmd_self_collect() {
    local dest="${1:-${MH_CASES_DIR}/_self/input}"
    "${MH_HOME}/scripts/self-collect.sh" "$dest"
}

# ─── demo ────────────────────────────────────────────────────────────────────

cmd_demo() {
    local autonomous=0
    local real_claude=0
    while (( $# > 0 )); do
        case "$1" in
            --autonomous|--auto) autonomous=1; shift ;;
            --real-claude)       real_claude=1; shift ;;
            -h|--help)
                echo "Usage: mh demo [--autonomous] [--real-claude]"
                echo ""
                echo "  (default)        Self-collect + parse + audit log; no tokens."
                echo "  --autonomous     Reserved for Sub-Plan 02+ Claude Code chained run."
                echo "  --real-claude    Self-collect + run mh-orchestrate with real Claude"
                echo "                   on the triage subagent only (token-bounded smoke test)."
                echo "                   Honors MH_DEMO_NONINTERACTIVE=1 to skip the y/N prompt."
                return 0
                ;;
            *) fail "Unknown flag: $1"; echo "Run: mh demo --help" >&2; return 2 ;;
        esac
    done

    if (( real_claude )); then
        _demo_real_claude
        return $?
    fi

    _demo_stub "$autonomous"
}

# ─── demo: stub-mode (default, no Claude) ───────────────────────────────────
# Self-collects safe artifacts, ingests + classifies them, writes audit log.
# No tokens, no LLM. Safe to run on CI / dev hosts.
_demo_stub() {
    local autonomous="${1:-0}"

    info "MemoryHound demo — collects safe artifacts from THIS host, parses them, writes audit log."
    echo ""

    local demo_dir="${MH_CASES_DIR}/_demo"
    rm -rf "$demo_dir"
    mkdir -p "${demo_dir}/input" "${demo_dir}/output"

    info "Step 1: self-collect host artifacts"
    "${MH_HOME}/scripts/self-collect.sh" "${demo_dir}/input" 2>&1 | sed 's/^/    /'

    local audit_log="${demo_dir}/output/audit.jsonl"
    export EVIDENCE_PATH="${demo_dir}/input"
    export OUTPUT_PATH="${demo_dir}/output"

    # Anchor chain-of-custody: write manifest.json before any other audit
    # event so `mh verify _demo` has something to re-hash against.
    info "Step 1b: SHA256 manifest of collected artifacts"
    PYTHONPATH="${MH_HOME}/orchestrator/src:${MH_HOME}/mcp-server/src" \
        "$MH_PY" -c "
from pathlib import Path
from mh_orchestrator.nodes.manifest_ingest import build_manifest, write_manifest, manifest_self_sha256
from protocol_sift_mcp.tools.audit import audit_append
inp = Path('${demo_dir}/input')
out = Path('${demo_dir}/output')
entries = build_manifest(inp)
mp = write_manifest(out, entries)
audit_append(out / 'audit.jsonl', event='manifest_complete', data={
    'input_dir': str(inp),
    'manifest_path': str(mp),
    'manifest_sha256': manifest_self_sha256(mp),
    'entry_count': len(entries),
    'errors': sum(1 for e in entries if 'error' in e),
})
print(f'    manifest.json: {len(entries)} entries, sha256 anchored in audit')
"
    ok "    manifest.json written"

    info "Step 2: ingest each artifact (compute sha256+sha1, append to audit log)"
    local ingested=0
    while IFS= read -r f; do
        PYTHONPATH="${MH_HOME}/mcp-server/src" "$MH_PY" -m protocol_sift_mcp.tools.evidence ingest \
            --audit "$audit_log" --artifact "$f" >/dev/null
        ingested=$((ingested + 1))
    done < <(find "${demo_dir}/input" -type f)
    ok "    $ingested artifacts ingested"

    info "Step 3: classify each artifact with os_detect + parse"
    local classified=0
    while IFS= read -r f; do
        local rel="${f#${demo_dir}/input/}"
        PYTHONPATH="${MH_HOME}/mcp-server/src" "$MH_PY" -c "
from protocol_sift_mcp.tools import parse, macos, audit
from pathlib import Path
import json
path = '$f'
det = parse.os_detect(path)
result = {'rel': '$rel', 'os': det['os'], 'class': det['evidence_class'], 'conf': det['confidence']}
if det['evidence_class'] == 'plist':
    try:
        r = macos.mac_plist_get(path)
        result['format'] = r['format']
        result['root_keys_count'] = len(r['root_keys'])
    except Exception as e:
        result['parse_error'] = str(e)[:80]
audit.audit_append(Path('$audit_log'), event='tool_call', data={'tool': 'os_detect+parse', 'artifact': '$rel', 'result': result})
print(json.dumps(result))
" 2>&1 | sed 's/^/    /'
        classified=$((classified + 1))
    done < <(find "${demo_dir}/input" -type f)
    ok "    $classified artifacts classified, all logged to $audit_log"

    echo ""
    ok "Demo complete."
    info "Audit log: $audit_log ($(wc -l <"$audit_log") entries)"

    if [[ "$autonomous" == "1" ]]; then
        echo ""
        info "Autonomous phase requires LangGraph orchestrator (Sub-Plan 02). Skipping for now."
    fi
}

# ─── demo: --real-claude mode (token-bounded live smoke) ────────────────────
# Exercises the per-node opt-in introduced by Sub-Plan 04 / T8:
#   MH_NO_CLAUDE=1 + MH_REAL_CLAUDE_NODES=triage
# Only the triage subagent talks to real Claude; analyze + verifier_pass stay
# stubbed. Estimated cost: ~1500 tokens, ~$0.01.
_demo_real_claude() {
    info "MemoryHound demo — REAL CLAUDE smoke (triage subagent only)"
    echo ""

    # 1. Auth precondition. Mirror cmd_run semantics: API key OR ~/.claude
    #    plus claude CLI on PATH. Bail loudly if neither auth path works.
    if [[ -z "${ANTHROPIC_API_KEY:-}" ]] && [[ ! -d "$HOME/.claude" ]]; then
        fail "No Claude auth detected."
        info "    Set ANTHROPIC_API_KEY=sk-ant-...   OR run: claude /login"
        return 1
    fi
    if ! command -v claude >/dev/null 2>&1; then
        fail "claude CLI not on PATH. Install: https://docs.claude.com/en/docs/claude-code/quickstart"
        return 1
    fi
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        info "Auth: ANTHROPIC_API_KEY"
    else
        info "Auth: claude CLI (subscription)"
    fi

    # 2. Token-cost confirmation. Honors MH_DEMO_NONINTERACTIVE=1 for CI.
    if [[ "${MH_DEMO_NONINTERACTIVE:-0}" != "1" ]]; then
        echo ""
        warn "About to invoke real Claude on the triage subagent."
        warn "Estimated cost: ~\$0.01 (≤1500 tokens)."
        warn "Set MH_DEMO_NONINTERACTIVE=1 to skip this prompt in CI."
        local response=""
        read -r -p "Continue? [y/N] " response || true
        case "$response" in
            [yY]|[yY][eE][sS]) ;;
            *) info "Aborted by user."; return 0 ;;
        esac
    else
        info "MH_DEMO_NONINTERACTIVE=1 — skipping y/N prompt."
    fi

    # 3. Self-collect into the _demo case dir.
    local case_id="_demo"
    local case_dir="${MH_CASES_DIR}/${case_id}"
    rm -rf "$case_dir"
    mkdir -p "${case_dir}/input" "${case_dir}/output"
    info "Step 1: self-collect host artifacts → ${case_dir}/input/"
    if ! "${MH_HOME}/scripts/self-collect.sh" "${case_dir}/input" 2>&1 | sed 's/^/    /'; then
        fail "self-collect.sh failed"
        return 1
    fi

    # 4. Invoke the orchestrator with the per-node opt-in.
    #    MH_NO_CLAUDE=1 keeps analyze + verifier_pass stubbed.
    #    MH_REAL_CLAUDE_NODES=triage flips ONLY the triage node to real Claude.
    info "Step 2: mh-orchestrate run ${case_id} --recursion-limit 30"
    info "    MH_NO_CLAUDE=1 MH_REAL_CLAUDE_NODES=triage"
    local start_ts=$SECONDS
    local exit_code=0
    MH_NO_CLAUDE=1 MH_REAL_CLAUDE_NODES=triage \
        cmd_orchestrate "$case_id" --recursion-limit 30 || exit_code=$?
    local elapsed=$((SECONDS - start_ts))

    # 5. Report.
    echo ""
    info "Real-Claude smoke complete:"
    echo "    exit_code:    $exit_code"
    echo "    elapsed:      ${elapsed}s"
    local audit_log="${case_dir}/output/audit.jsonl"
    if [[ -f "$audit_log" ]]; then
        echo "    audit lines:  $(wc -l < "$audit_log" | tr -d ' ')"
    else
        warn "    audit lines:  (no audit.jsonl emitted)"
    fi
    local msgs="${case_dir}/output/agent_messages.jsonl"
    if [[ -f "$msgs" ]]; then
        if command -v jq >/dev/null 2>&1; then
            local triage_text
            triage_text=$(jq -r '
                select((.from_agent == "WindowsAgent" or .from_agent == "MacOSAgent" or .from_agent == "LinuxAgent")
                       and .role == "response")
                | .content
            ' "$msgs" 2>/dev/null | head -1)
            if [[ -n "$triage_text" ]]; then
                echo "    triage final: $triage_text"
            else
                warn "    triage final: (no response message from triage subagent)"
            fi
        else
            warn "    triage final: (jq not installed; skipping extraction)"
        fi
    else
        warn "    agent_messages.jsonl not found at ${msgs}"
    fi

    return "$exit_code"
}

# ─── verify (chain-of-custody re-verification) ─────────────────────────────

# cmd_verify <case-id>
#
# Re-runs the chain-of-custody checks on a finished case:
#   1. Re-hash every file under cases/<case-id>/input/ and compare against
#      output/manifest.json. Any mismatch (size, sha256, or missing entry)
#      is reported and the exit code is non-zero.
#   2. Walk output/audit.jsonl and verify every prev_hash field matches the
#      sha256 of the predecessor entry. Tampered or reordered lines surface
#      as the first break.
#   3. (Optional) Same chain check on output/agent_messages.jsonl.
#
# Spoliation guarantee: original input/ MUST remain byte-identical after a
# run completes. This is the test the hackathon accuracy report calls out.
cmd_verify() {
    local case_id="${1:-}"
    if [[ -z "$case_id" ]]; then
        fail "Usage: mh verify <case-id>"
        return 2
    fi
    local case_dir="${MH_CASES_DIR}/${case_id}"
    local input_dir="${case_dir}/input"
    local output_dir="${case_dir}/output"
    local manifest="${output_dir}/manifest.json"
    local audit_log="${output_dir}/audit.jsonl"
    local msg_log="${output_dir}/agent_messages.jsonl"

    if [[ ! -d "$output_dir" ]]; then
        fail "No output dir at ${output_dir} — run 'mh orchestrate ${case_id}' first"
        return 1
    fi

    local rc=0
    info "Verifying case ${case_id}"
    echo ""

    # Manifest check
    if [[ ! -f "$manifest" ]]; then
        warn "manifest.json missing — chain-of-custody anchor never written"
        rc=1
    else
        info "1/3  Manifest re-hash"
        if "$MH_PY" "${MH_HOME}/scripts/verify-manifest.py" \
                --input "$input_dir" --manifest "$manifest"; then
            ok "    manifest matches input/ (no spoliation detected)"
        else
            fail "    manifest mismatch — see lines above"
            rc=1
        fi
    fi

    # Audit-log chain
    info "2/3  Audit log hash chain"
    if [[ ! -f "$audit_log" ]]; then
        warn "    audit.jsonl missing — nothing to verify"
    else
        if "$MH_PY" -c "
import json, sys
from pathlib import Path
from protocol_sift_mcp.tools.audit import verify_audit_chain
r = verify_audit_chain(Path('$audit_log'))
print(json.dumps(r))
sys.exit(0 if r['ok'] else 1)
" 2>&1 | tee /tmp/mh-verify-audit-$$.json; then
            ok "    audit chain intact ($(jq -r .entries </tmp/mh-verify-audit-$$.json 2>/dev/null || echo '?') entries)"
        else
            fail "    audit chain broken — see report above"
            rc=1
        fi
        rm -f /tmp/mh-verify-audit-$$.json
    fi

    # Agent-messages chain (optional file)
    info "3/3  Agent messages hash chain"
    if [[ ! -f "$msg_log" ]]; then
        info "    agent_messages.jsonl missing — skipping (optional)"
    else
        if "$MH_PY" -c "
import json, sys
from pathlib import Path
from protocol_sift_mcp.tools.audit import verify_audit_chain
r = verify_audit_chain(Path('$msg_log'))
print(json.dumps(r))
sys.exit(0 if r['ok'] else 1)
"; then
            ok "    agent_messages chain intact"
        else
            fail "    agent_messages chain broken"
            rc=1
        fi
    fi

    echo ""
    if (( rc == 0 )); then
        ok "Verification PASSED — case ${case_id} chain-of-custody intact"
    else
        fail "Verification FAILED — review breaks above"
    fi
    return $rc
}

# ─── help ────────────────────────────────────────────────────────────────────

cmd_help() {
    cat <<EOF
${BOLD}MemoryHound — autonomous DFIR triage with Claude Code${NC}

${BOLD}USAGE${NC}
    mh <command> [args]

${BOLD}COMMANDS${NC}
    init [--with-forensics]   First-time setup: venv, deps.
                              --with-forensics adds heavy libs (Volatility, etc.)
    quickstart                One command from "installed" to "demo running."
                              doctor + auth check + stub demo. No tokens.
    doctor                    Health check across env, deps, auth.
    self-collect [DEST]       Copy safe DFIR artifacts from this host into DEST
                              (default cases/_self/input). No root, no creds.
    demo [--autonomous]       Real-data showcase: self-collect + parse + audit log,
                              all on YOUR machine, no tokens.
    run <case|file|folder>    Full IR triage in one command. Accepts:
                                - case name:  mh run case-001
                                - file path:  mh run /tmp/memdump.raw
                                - folder:     mh run /tmp/evidence/
                              Default: LangGraph (deterministic, full pipeline).
                              --interactive: skill-driven Claude TUI.
    orchestrate <case>        Alias for 'mh run' (legacy).
    scope <base> --hosts=CSV  Parallel SSH self-collect across multiple hosts
                              into cases/<base>-<host>/input/.
    report [--exec|--pdf] <case-id>
                              Plain-English summary by default;
                              --exec emits one-page exec view + technical
                              appendix + per-platform containment commands;
                              --pdf renders the exec report to a branded PDF
                              (requires weasyprint + markdown — install via
                              `mh init` with the [reports] extra).
    serve [--port=N]          Local web viewer for cases (markdown rendered,
                              audit log pretty-printed). Default port 8765.
    status                    List cases + their phase.
    tools                     List MCP tools the agent can call.
    verify <case-id>          Re-hash input/ vs output/manifest.json AND
                              re-verify audit.jsonl prev_hash chain. Non-zero
                              exit on any break. The spoliation test the
                              accuracy report records before/after.
    check                     Quick env probe (exit 0/1).
    help                      Show this.

${BOLD}WORKFLOW${NC}
    1. bash scripts/install.sh        # one-line bootstrap
    2. claude /login                  # (or: export ANTHROPIC_API_KEY=sk-ant-...)
    3. mh quickstart                  # auth check + free stub demo
    4. mh run /path/to/evidence       # full IR triage — one command
    5. mh serve                       # browse results

${BOLD}DEPLOYMENT${NC} (advanced — host bootstrap with full forensics toolchain)
    scripts/install-sift.sh --check               Report prereq status (no changes)
    scripts/install-sift.sh --install             Bootstrap SIFT/Ubuntu host

    See docs/deployment.md for the full matrix (incl. Docker paths).

${BOLD}DOCS${NC}
    docs/architecture.md      — full design
    docs/usage.md             — detailed usage
    docs/development.md       — pre-commit + CI workflow

${BOLD}HOMEPAGE${NC}
    https://github.com/saivarun3407/DFIR-AI
EOF
}

# ─── dispatch ────────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        init)         cmd_init "$@" ;;
        doctor)       cmd_doctor "$@" ;;
        quickstart)   cmd_quickstart "$@" ;;
        demo)         cmd_demo "$@" ;;
        self-collect) cmd_self_collect "$@" ;;
        run)          cmd_run "$@" ;;
        orchestrate)  cmd_orchestrate "$@" ;;
        scope)        cmd_scope "$@" ;;
        report)       cmd_report "$@" ;;
        serve)        cmd_serve "$@" ;;
        status)       cmd_status "$@" ;;
        tools)        cmd_tools "$@" ;;
        verify)       cmd_verify "$@" ;;
        check)        cmd_check "$@" ;;
        help|-h|--help) cmd_help ;;
        *)            fail "Unknown command: $cmd"; cmd_help; return 2 ;;
    esac
}

main "$@"
